# Copy to .env for local development (`npm run dev` serves the API too), and
# set the same names in Vercel -> Project -> Settings -> Environment Variables.
#
# None of these may start with VITE_: Vite copies VITE_ variables into the
# browser bundle, and every value here must stay on the server.

# --- The shared Supabase project (Project Settings -> API) ---
SUPABASE_URL=https://chmeruyynzngfojbikmo.supabase.co
SUPABASE_ANON_KEY=

# --- Yumli's service account (Authentication -> Users) ---
# The only account that can read or change Yumli's data and images.
YUMLI_SERVICE_EMAIL=yumli-api@kayv.os
YUMLI_SERVICE_PASSWORD=

# --- Admin dashboard login (/admin) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the login cookie. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Only for `npm run migrate` (one-time move from the old project) ---
# The old project's URL and anon key: the values Yumli used to have as
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.
OLD_SUPABASE_URL=
OLD_SUPABASE_ANON_KEY=
